# ------------------------------------------------------------
# ConfigCat MCP Server example environment configuration
#
# Default mode is stdio:
#   mcp-server
# Explicit stdio mode:
#   mcp-server stdio
# HTTP mode:
#   mcp-server http
# ------------------------------------------------------------

# Required in both stdio and http modes
CONFIGCAT_API_USER=YOUR_CONFIGCAT_PUBLIC_API_USERNAME
CONFIGCAT_API_PASS=YOUR_CONFIGCAT_PUBLIC_API_PASSWORD

# Optional in both modes
CONFIGCAT_BASE_URL=https://api.configcat.com

# ------------------------------------------------------------
# HTTP mode transport settings (used only with: mcp-server http)
# ------------------------------------------------------------
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# Optional comma-separated host allowlist for host header validation
# Example: MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.com
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL used to publish OAuth resource metadata
# In production set this to the externally reachable server URL.
MCP_HTTP_PUBLIC_BASE_URL=http://127.0.0.1:3000

# ------------------------------------------------------------
# OAuth 2.1 / Bearer auth settings (required in http mode)
# ------------------------------------------------------------
MCP_OAUTH_ISSUER=https://auth.example.com
MCP_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
MCP_OAUTH_TOKEN_ENDPOINT=https://auth.example.com/token
MCP_OAUTH_INTROSPECTION_ENDPOINT=https://auth.example.com/introspect

# Optional dynamic client registration endpoint
MCP_OAUTH_REGISTRATION_ENDPOINT=https://auth.example.com/register

# Optional supported scopes advertised by the MCP resource server
# Comma-separated
MCP_OAUTH_SCOPES=mcp:tools

# Optional required scopes that bearer tokens must include
# Comma-separated
MCP_OAUTH_REQUIRED_SCOPES=mcp:tools

# Optional: set to false to disable RFC 8707 audience/resource enforcement
MCP_OAUTH_ENFORCE_RESOURCE=true

# Optional: client credentials sent to introspection endpoint
MCP_OAUTH_INTROSPECTION_CLIENT_ID=your-introspection-client-id
MCP_OAUTH_INTROSPECTION_CLIENT_SECRET=your-introspection-client-secret
